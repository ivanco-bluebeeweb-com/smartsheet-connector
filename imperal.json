      "name": "connect_smartsheet",
      "description": "Connect your own Smartsheet account by saving your API Access Token.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "Friendly connection label, e.g. Operations Smartsheet.",
            "title": "Label",
            "type": "string"
          },
          "access_token": {
            "description": "Smartsheet generated API access token (Bearer).",
            "title": "Access Token",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "ConnectSmartsheetParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {
            "description": "Connection ID",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "description": "Connection label",
            "title": "Label",
            "type": "string"
          },
          "status": {
            "default": "connected",
            "description": "Status",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "ConnectResult",
        "type": "object"
      },
      "event": "smartsheet-connector.connect_smartsheet",
      "background": false,
      "long_running": false,
      "scopes": [],
